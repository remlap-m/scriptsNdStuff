//staging prior to exfil
let ExcludedAccounts   = dynamic([]);            // matched on AccountUpn (lowercase)
// Bulk-writers that are noise, not signal. Do NOT blanket-exclude browsers
// or Office - those are the likely vectors. Scope them by folder instead.
// POPULATE THIS FROM THE DISCOVERY QUERY BEFORE DEPLOYING.
let ExcludedProcesses  = dynamic([ "REMOVED.exe"]);
let ExcludedFolders    = dynamic([
    @"\AppData\Local\Temp\",
    @"\AppData\Local\Microsoft\Windows\INetCache\",
    @"\AppData\Local\Microsoft\Windows\WebCache\",
    @"\AppData\Local\Packages\",
    @"\AppData\Roaming\Microsoft\Windows\Recent\",
    @"\Google\Chrome\User Data\",
    @"\Microsoft\Edge\User Data\",
    @"C:\Windows\",
    @"C:\ProgramData\",
    @"C:\Program Files",
    @"$Recycle.Bin",
    @"\OneDriveTemp\"
]);
// Legal-relevant document types. Trim or extend from your own baseline.
let InterestingExt     = dynamic([
    "doc", "docx", "docm", "dot", "dotx",
    "xls", "xlsx", "xlsm", "ppt", "pptx",
    "pdf", "msg", "eml", "rtf", "txt", "csv",
    "zip", "7z", "rar", "pst", "ost"
]);
let Threshold          = 200;    // files created in the window - SET FROM BASELINE
let MinFiles           = 150;    // distinct docs floor - drops rewrite/retry loops
let Bucket             = 20m;   // detection window
let Step               = 5m;    // grid spacing; guarantee = Bucket - Step = 25m
let Offsets            = range(0, 25, 5);        // minute offsets: 0,5,10,15,20,25
let Liveness           = 60m;   // MUST exceed rule frequency
let Lookback           = 30m;
let Skew               = 30m;   // TimeGenerated vs Timestamp drift allowance
DeviceFileEvents
| where TimeGenerated > ago(Lookback + Skew)     // wide: partition pruning + late arrivals
| where Timestamp     > ago(Lookback)            // tight: matches the binning column
| where ActionType == "FileCreated"
| where isnotempty(FileName)
// --- cheap filters first: this table is huge and mv-expand multiplies rows ---
| where InitiatingProcessFileName !in~ (ExcludedProcesses)
| where isnotempty(InitiatingProcessAccountUpn)
| where not(FolderPath has_any (ExcludedFolders)) //noise filtering (specific folders)
//| where FolderPath startswith "C:\\"
| where not (InitiatingProcessCommandLine has_any ("/systemstartup", "Quarantine")) //noise filtering
// Office lock/temp artefacts and partial downloads
| where not(FileName startswith "~$")
| where not(FileName has_any (".tmp", ".partial", ".crdownload", ".part", ".filepart"))
| where not (FileName startswith "PowerShell_transcript")
// DeviceFileEvents has no FileExtension column - derive it (no negative indexing in KQL)
| extend NameParts = split(FileName, ".")
| extend Ext = tolower(tostring(split(FileName, ".")[-1]))
| where Ext in (InterestingExt)
| extend AccountUpn = tolower(InitiatingProcessAccountUpn)
| where AccountUpn !in~ (ExcludedAccounts)       // now matches the grouping key
| extend IngestAt = ingestion_time()
// VERIFY: if FolderPath already ends with FileName in your tenant, this is a no-op
// and DistinctFolders == DistinctFiles. Swap to parse_path(FolderPath).DirectoryPath.
| extend DirPath = tostring(parse_path(FolderPath).DirectoryPath)
// --- sliding window grid ---
| extend Off = Offsets
| mv-expand Off to typeof(long)
| extend WindowStart = bin(Timestamp - Off * 1m, Bucket) + Off * 1m
| summarize
    FilesCreated    = count(),
    DistinctFiles   = count_distinct(strcat(DirPath, "|", FileName)),   // exact, path-qualified
    DistinctFolders = dcount(DirPath),
    ParentProcess   = take_any(InitiatingProcessParentFileName),
    CommandLine     = take_any(InitiatingProcessCommandLine),
    TotalBytes      = sum(FileSize),
    FileSample      = make_set(FileName, 50),
    FolderSample    = make_set(DirPath, 15),
    Processes       = make_set(InitiatingProcessFileName, 10),
    OriginUrls      = make_set(FileOriginUrl, 10),
    Labels          = make_set(SensitivityLabel, 10),
    NetworkPathHits = countif(FolderPath startswith @"\\"),             // UNC / mapped share
    OtherDriveHits  = countif(FolderPath matches regex @"^[D-Zd-z]:\\"),// USB proxy - see note
    RemoteSession   = countif(IsInitiatingProcessRemoteSession == true),
    FirstEvent      = min(Timestamp),
    LastEvent       = max(Timestamp),
    IngestLast      = max(IngestAt),
    take_any(DeviceName, DeviceId, InitiatingProcessAccountName,
             InitiatingProcessFileName, InitiatingProcessSHA256,
             InitiatingProcessFolderPath, FileName, FolderPath)
  by AccountUpn, DeviceId, WindowStart
| where FilesCreated >= Threshold
| where DistinctFiles >= MinFiles                // >= to match Threshold's semantics
// Report only windows whose newest record ARRIVED since the last run.
// Without this, a 2h lookback re-reports every burst on ~8 consecutive runs.
| where IngestLast > ago(Liveness)
// Sliding grids mean one burst qualifies in many overlapping windows.
// arg_max with * preserves column names - the explicit-list form does not.
| summarize arg_max(FilesCreated, *) by AccountUpn, DeviceId
// ---------- enrich ----------
| extend WindowEnd    = WindowStart + Bucket
| extend BurstMinutes = datetime_diff('minute', LastEvent, FirstEvent)
| extend FilesPerMin  = round(todouble(FilesCreated) / max_of(todouble(BurstMinutes), 1.0), 1)
| extend TotalMB      = round(todouble(TotalBytes) / 1024.0 / 1024.0, 1)
// Scalar columns for entity mapping (entities cannot map to make_set arrays)
| extend SampleFile   = FileName
| extend SampleFolder = FolderPath
| extend ProcessName  = InitiatingProcessFileName
| project
    WindowStart,
    WindowEnd,
    DeviceName,
    DeviceId,
    AccountUpn,
    InitiatingProcessAccountName,
    FilesCreated,
    DistinctFiles,
    DistinctFolders,
    TotalMB,
    FilesPerMin,
    BurstMinutes,
    FirstEvent,
    LastEvent,
    ProcessName,
    InitiatingProcessSHA256,
    InitiatingProcessFolderPath,
    NetworkPathHits,
    OtherDriveHits,
    RemoteSession,
    FileSample,
    FolderSample,
    Processes,
    CommandLine,
    OriginUrls,
    SampleFolder,
    SampleFile,
    Labels
| order by FilesPerMin desc, DistinctFolders desc, FilesCreated desc
